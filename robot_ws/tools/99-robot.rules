# /etc/udev/rules.d/99-robot.rules
# VID/PID는 실물에서 확인한 뒤 아래 자리 표시(XXXX)를 바꾼다. 확인 필요
#   lsusb                                   -> "ID vvvv:pppp" 확인
#   udevadm info -a -n /dev/ttyACM0         -> ATTRS{idVendor}, ATTRS{idProduct}, ATTRS{serial} 확인
# 같은 칩의 어댑터가 둘이면 ATTRS{serial}도 조건에 넣어 구분한다.
# 적용: sudo udevadm control --reload-rules && sudo udevadm trigger
# 사용자는 dialout 그룹에 넣는다: sudo usermod -aG dialout $USER

# OpenRB-150 (USB CDC, /dev/ttyACM*)
SUBSYSTEM=="tty", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", SYMLINK+="openrb", MODE="0666"

# RPLIDAR A1 USB 어댑터. 보통 CP210x(10c4:ea60)이지만 실물로 확인한다.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="rplidar", MODE="0666"
